import numpy as np
from sklearn.linear_model import Ridge

def inverse_map(pf_F, pf_X, target_F, bounds_X, alpha=1e-3):
    """
    Inverse mapping using Ridge Regression, with safeguards.
    """
    try:
        # Safeguard: Ensure sufficient samples.
        if pf_X.shape[0] < pf_X.shape[1]:  # Check for underdetermined system
            print("Warning: Underdetermined system detected. Returning a default solution.")
            return np.mean(bounds_X, axis=0)  # Return the mean of all bounds (or a random valid point)

        # Safeguard: Avoid division by zero and ill-conditioned matrices.
        ridge = Ridge(alpha=alpha)
        ridge.fit(pf_F, pf_X)
        inverse_X = ridge.predict(target_F)

        # Clip to bounds, with a small expansion (to handle edge cases)
        return np.clip(inverse_X, bounds_X[:, 0] - 1e-6, bounds_X[:, 1] + 1e-6)

    except np.linalg.LinAlgError as e:
        print(f"Linear Algebra Error in Ridge: {e}. Returning a default solution.")
        return np.mean(bounds_X, axis=0)  # Return the mean of all bounds (or a random valid point)

def calculate_diagnostics(pf_F, pf_X, all_X, valid_loss_threshold=5.0):
    """
    Calculates separability and multimodality metrics.
    """
    valid_mask = pf_F[:, 0] < valid_loss_threshold  # Ensure valid data
    if np.sum(valid_mask) == 0:
        return {'separability': np.nan, 'multimodality': np.nan}

    pf

